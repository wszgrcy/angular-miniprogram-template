{
  "name": "angular-miniprogram-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build --watch",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test:build": "ng run first:test",
    "test:wechat": "node ./scripts/wechat-vitest.cjs --project . --dist ./dist/vitest/first --target first:test",
    "build:lib": "ng build first",
    "typecheck": "tsc -b"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/localize": "22.1.7",
    "angular-miniprogram": "2.0.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@types/node": "^22.19.0",
    "miniprogram-api-typings": "^5.2.3",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
