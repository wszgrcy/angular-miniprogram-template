/* `first` 库的构建配置，被 ng-packagr 用到（`ng-package.json` 的入口 +
   angular.json 的 `tsConfig`）。类型检查走 `tsconfig.lib.check.json`。
   `src/spec/**` 是测试夹具，不是库源码，这里排除掉。 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": ["src/test.ts", "src/spec/**", "**/*.spec.ts"],
  "angularCompilerOptions": {
    "compilationMode": "full"
  }
}
